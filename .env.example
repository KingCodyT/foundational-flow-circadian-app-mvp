# Use one durable Redis REST pair. Never prefix secrets with NEXT_PUBLIC_.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Alternatives: KV_REST_API_URL and KV_REST_API_TOKEN
QSTASH_TOKEN=
PUSH_DISPATCH_SECRET=
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=
# Public HTTPS origin reachable by both the phone and QStash; no trailing path.
APP_ORIGIN=
